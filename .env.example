# ---------- Server (set these in Vercel → Project → Settings → Environment Variables) ----------
# Postgres connection string. Use the *pooled* URL from Neon or Supabase, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Shared access key. When set, the API rejects requests that do not send it.
# Use a long random value (e.g. `openssl rand -hex 32`) and put the SAME value in VITE_API_KEY below.
MAADA_API_KEY=
# Extra browser origins allowed to call the API (comma separated). The Android app is always allowed.
ALLOWED_ORIGINS=
# Max write requests per client per minute (default 120, 0 disables).
WRITE_RATE_LIMIT=120
# Apply database migrations automatically on cold start (default true).
AUTO_MIGRATE=true

# ---------- App build (read by Vite at build time) ----------
# Leave empty for the web build on Vercel (same origin). For the Android APK set the full URL,
# e.g. https://your-project.vercel.app — put it in .env.android.
VITE_API_BASE_URL=
VITE_API_KEY=
